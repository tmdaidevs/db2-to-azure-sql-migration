# Paths
MIGRATION_ROOT=.
ARTIFACT_DIR=.\migration-artifacts

# Source DB2
DB2_PLATFORM=LUW
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_SCHEMA_SCOPE=
DB2_USER=
DB2_PASSWORD=
DB2_TLS_REQUIRED=true
DB2_CODE_PAGE=
DB2_TIMEZONE=
DB2_PROVIDER=auto
DB2_CLIENT_PATH=
SSMA_CONSOLE_PATH=

# Azure SQL target
AZURE_SQL_TARGET=database
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_AUTH=entra
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_COMPATIBILITY_LEVEL=
AZURE_SQL_TLS_REQUIRED=true

# Execution policy
MIGRATION_MODE=offline
ALLOW_DESTRUCTIVE_TARGET_ACTIONS=false
ALLOW_PRODUCTION_CUTOVER=false
ALLOW_SOURCE_WRITES=false
ALLOW_SSMA_COMPATIBILITY_HELPERS=false
REQUIRE_BEHAVIORAL_VALIDATION=true
MAX_REMEDIATION_ATTEMPTS=3
COMMAND_TIMEOUT_SECONDS=3600
RETRY_COUNT=3
RETRY_DELAY_SECONDS=5

# Optional migration controls
DATA_MIGRATION_STRATEGY=ssma
MIGRATION_BATCH_SIZE=10000
MIGRATION_PARALLELISM=1
MIGRATION_DOWNTIME_WINDOW=
VALIDATION_QUERY_DIR=
PERFORMANCE_THRESHOLD_PERCENT=20
